# Consulting service. With none of these set, the game uses its own rule-based advisor and
# makes no network calls — which is what the published build does.
#
# Copy this file to .env.local and fill in one line. .env.local is git-ignored, `vite dev` is
# the only thing that ever reads a credential from it, and `npm run build` fails outright if
# anything key-shaped reaches dist/.

# --- Local development: reach a model straight from the browser ---------------------------
# Fill in exactly one of these. Gemini is used when both are present.
# VITE_GEMINI_API_KEY=
# VITE_ANTHROPIC_API_KEY=

# --- A released build: a small server of ours holds the credential --------------------------
# It receives { "brief": { ... } } and answers { "note": "...", "picks": [ ... ] }.
# Which model sits behind it is the server's business (see tools/consulting-relay.mjs).
# VITE_CONSULTING_URL=https://example.com/api/consulting

# --- Optional ------------------------------------------------------------------------------
# 'gemini' or 'anthropic'; otherwise whichever of the two above is filled in.
# VITE_CONSULTING_PROVIDER=gemini
# Defaults: gemini-2.5-flash, or claude-sonnet-5.
# VITE_CONSULTING_MODEL=
# VITE_CONSULTING_TIMEOUT_MS=12000
