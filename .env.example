# Consulting service. With neither of these set, the game uses its own rule-based advisor
# and makes no network calls — which is what the published build does.

# Local development only: your own Anthropic key, used straight from the browser.
# Copy this file to .env.local and fill it in. .env.local is git-ignored, and a production
# build ignores this variable entirely so a key can never be published.
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# For a released build: a small server of ours that holds the key and forwards the request.
# It receives { "brief": { ... } } and answers { "note": "...", "picks": [ ... ] }.
# VITE_CONSULTING_URL=https://example.com/api/consulting

# VITE_CONSULTING_MODEL=claude-sonnet-5
# VITE_CONSULTING_TIMEOUT_MS=12000
